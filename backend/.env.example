# ---------------------------------------------------------------------------
# PAIMANA-AI backend environment
#
# Copy this file to `.env` in the backend directory and fill in your key.
# NEVER commit the real .env file. The key is read by the backend only and is
# never sent to, or rendered in, the React frontend.
# ---------------------------------------------------------------------------

# Google Gemini API key. Get one at https://aistudio.google.com/apikey
# If this is left unset the assistant runs in local rule-based fallback mode
# and the UI displays "LLM mode unavailable - using local assistant fallback."
GEMINI_API_KEY=your_key_here

# Optional: override the Gemini model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
